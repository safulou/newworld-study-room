# Leave blank to use the public PeerJS Cloud signaling service during MVP development.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
VITE_PEER_KEY=peerjs

# Same-origin Cloudflare Pages Function that returns short-lived ICE credentials.
# Leave blank to use STUN-only connectivity during local and GitHub Pages development.
VITE_TURN_CREDENTIALS_URL=

# Optional provider-neutral endpoint. It must return modelUrl or a pollable statusUrl.
VITE_DOLL_GENERATION_URL=

# Override only when deploying under a repository subpath.
VITE_BASE_PATH=/newworld-study-room/
