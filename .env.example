# Leave blank to use the public PeerJS Cloud signaling service during MVP development.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
VITE_PEER_KEY=peerjs

# Configure TURN for users behind restrictive NATs. Use short-lived credentials in production.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
